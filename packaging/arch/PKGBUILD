# Maintainer: Michał Ligus <eshaiotic@eshaiotic.io>
#
# Builds InDuckGo from the repository this file lives in: the working tree as it is, uncommitted changes
# included. Usually run through ./install or packaging/release.sh; by hand: cd packaging/arch && makepkg -si
# The flags of /etc/makepkg.conf apply, so the package may be tuned for this machine's processor.

pkgname=induckgo
pkgver=1.2.4
pkgrel=1
pkgdesc="Privacy-first browser on QtWebEngine (Chromium), built on DuckDuckGo's open-source tracker protections"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
# QtWebEngine is Chromium: the engine's security fixes arrive with Arch's qt6-webengine, not with InDuckGo.
# qt6-svg draws the interface's icons, qt6-declarative holds Qt Quick with its Controls, Dialogs and Effects,
# qt6-webchannel the bridge between the page and the browser.
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-webchannel'
         'qt6-webengine')
makedepends=('cargo')
# The release profile strips symbols, so a separate debug package would be empty. makepkg's link-time
# optimisation flags would make the C++ part of the Qt bridge unreadable for Rust's linker (undefined symbols).
options=('!debug' '!lto')

_repository="$(realpath "$startdir/../..")"

prepare() {
  cd "$_repository"
  # pacman versions have no hyphen: a release candidate 1.2.4-rc.1 of Cargo is 1.2.4rc1 here.
  local cargo_version="${pkgver/rc/-rc.}"
  if ! grep -qx "version = \"$cargo_version\"" Cargo.toml; then
    error "pkgver $pkgver differs from the version in Cargo.toml"
    return 1
  fi
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_repository"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p induckgo-qt
}

check() {
  cd "$_repository"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen -p induckgo-core
}

package() {
  cd "$_repository"
  install -Dm0755 "$srcdir/target/release/induckgo-qt" "$pkgdir/usr/bin/induckgo"
  install -Dm0644 packaging/linux/io.github.induckgo.InDuckGo.desktop -t "$pkgdir/usr/share/applications"
  install -Dm0644 packaging/linux/io.github.induckgo.InDuckGo.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm0644 assets/icons/io.github.induckgo.InDuckGo.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
  install -Dm0644 NOTICE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm0644 README.md -t "$pkgdir/usr/share/doc/$pkgname"
}
