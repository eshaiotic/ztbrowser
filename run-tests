#!/bin/sh
# Runs every ZTBrowser test with cargo-nextest and always writes the HTML test report to
# tests/reports/test-report-YYYYMMDD-HHmm.html (run history in test-results/; both ignored by git).
# With cargo-llvm-cov installed (pacman -S cargo-llvm-cov) the report also shows ztbrowser-core's coverage.
# Exits with the tests' status once the report is written. Outside CI the report opens in the browser.
#
# Usage: ./run-tests
set -eu
cd "$(dirname "$0")"

coverage=test-results/coverage-summary.json
nextest_junit=target/nextest/report/junit.xml
coverage_junit=target/llvm-cov-target/nextest/report/junit.xml
mkdir -p test-results
rm -f "$coverage" "$nextest_junit" "$coverage_junit"

# The Qt crates' tests start Qt and, in one case, the whole browser: without a screen they use Qt's offscreen
# platform, and as root (a container) Chromium's sandbox, which refuses to run there, is switched off.
export QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-offscreen}
[ "$(id -u)" != 0 ] || export QTWEBENGINE_DISABLE_SANDBOX=1
workspace="--workspace"

status=0
if cargo llvm-cov --version >/dev/null 2>&1; then
  # A distribution's Rust (not rustup) is built on the system LLVM, so cargo-llvm-cov uses its tools.
  if ! command -v rustup >/dev/null 2>&1; then
    LLVM_COV=${LLVM_COV:-$(command -v llvm-cov || true)}
    LLVM_PROFDATA=${LLVM_PROFDATA:-$(command -v llvm-profdata || true)}
    export LLVM_COV LLVM_PROFDATA
  fi
  cargo llvm-cov nextest --profile report $workspace \
    --exclude-from-report ztbrowser --exclude-from-report ztbrowser-test-report \
    --exclude-from-report ztbrowser-engine-qt --exclude-from-report ztbrowser-qt \
    --json --summary-only --output-path "$coverage" || status=$?
else
  echo "run-tests: cargo-llvm-cov is not installed, the report shows no coverage (pacman -S cargo-llvm-cov)" >&2
  cargo nextest run --profile report $workspace || status=$?
fi

junit=$coverage_junit
[ -f "$junit" ] || junit=$nextest_junit
report=$(cargo run --quiet --locked -p ztbrowser-test-report -- --junit "$junit" --coverage "$coverage")
echo "$report"
if [ -z "${CI:-}" ] && command -v xdg-open >/dev/null 2>&1; then
  xdg-open "${report#Raport HTML: }" >/dev/null 2>&1 &
fi
exit "$status"
