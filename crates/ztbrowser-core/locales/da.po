msgid "ZTBrowser opens links from other programs"
msgstr "ZTBrowser åbner links fra andre programmer"

msgid "Links from other programs open in {browser}"
msgstr "Links fra andre programmer åbnes i {browser}"

msgid "Another browser opens links from other programs"
msgstr "En anden browser åbner links fra andre programmer"

msgid "Only an installed ZTBrowser can open links from other programs"
msgstr "Kun en installeret ZTBrowser kan åbne links fra andre programmer"

msgid "The desktop does not say which browser opens links"
msgstr "Skrivebordet oplyser ikke, hvilken browser der åbner links"

msgid "Ask When ZTBrowser Starts"
msgstr "Spørg, når ZTBrowser starter"

msgid "Offer to make ZTBrowser the default browser while another browser opens links"
msgstr "Tilbyd at gøre ZTBrowser til standardbrowser, mens en anden browser åbner links"
