msgstr "Το Tor δεν μπορεί να χρησιμοποιήσει τη διαδρομή {path}"

msgid "Tor closed its control port"
msgstr "Το Tor έκλεισε τη θύρα ελέγχου του"

msgid "Tor could not switch circuits: {error}"
msgstr "Το Tor δεν μπόρεσε να αλλάξει κυκλώματα: {error}"

msgid "Tor did not open its control port"
msgstr "Το Tor δεν άνοιξε τη θύρα ελέγχου του"

msgid "Tor is not installed. Install your distribution's tor package; the Tor window starts its own Tor and needs no Tor service running."
msgstr "Το Tor δεν είναι εγκατεστημένο. Εγκαταστήστε το πακέτο tor της διανομής σας· το παράθυρο Tor εκκινεί το δικό του Tor και δεν χρειάζεται υπηρεσία Tor σε λειτουργία."

msgid "Tor opened no local SOCKS port"
msgstr "Το Tor δεν άνοιξε τοπική θύρα SOCKS"

msgid "Tor refused: {reason}"
msgstr "Το Tor αρνήθηκε: {reason}"

msgid "Tor reported a problem"
msgstr "Το Tor ανέφερε πρόβλημα"

msgid "Tor stopped."
msgstr "Το Tor σταμάτησε."

msgid "Tor's control cookie is damaged"
msgstr "Το cookie ελέγχου του Tor είναι κατεστραμμένο"

msgid "Tracker Data Set"
msgstr "Σύνολο δεδομένων ιχνηλατών"

