msgid "About ZTBrowser"
msgstr "ກ່ຽວກັບ ZTBrowser"

msgid "Access denied"
msgstr "ປະຕິເສດການເຂົ້າເຖິງ"

msgid "Allow {requesting} to use its cookies and data while you are on {current}?"
msgstr "ອະນຸຍາດໃຫ້ {requesting} ໃຊ້ຄຸກກີ ແລະ ຂໍ້ມູນຂອງມັນ ໃນຂະນະທີ່ທ່ານຢູ່ໃນ {current} ຫຼືບໍ່?"

msgid "Allow {site} to know your location?"
msgstr "ອະນຸຍາດໃຫ້ {site} ຮູ້ສະຖານທີ່ຂອງທ່ານຫຼືບໍ່?"

msgid "Allow {site} to read your clipboard?"
msgstr "ອະນຸຍາດໃຫ້ {site} ອ່ານຄລິບບອດຂອງທ່ານຫຼືບໍ່?"

msgid "Allow {site} to show notifications?"
msgstr "ອະນຸຍາດໃຫ້ {site} ສະແດງການແຈ້ງເຕືອນຫຼືບໍ່?"

msgid "Allow {site} to use your camera and microphone?"
msgstr "ອະນຸຍາດໃຫ້ {site} ໃຊ້ກ້ອງ ແລະ ໄມໂຄຣໂຟນຂອງທ່ານຫຼືບໍ່?"

msgid "Allow {site} to use your camera?"
msgstr "ອະນຸຍາດໃຫ້ {site} ໃຊ້ກ້ອງຂອງທ່ານຫຼືບໍ່?"

msgid "Allow {site} to use your microphone?"
msgstr "ອະນຸຍາດໃຫ້ {site} ໃຊ້ໄມໂຄຣໂຟນຂອງທ່ານຫຼືບໍ່?"

msgid "Allow {site} to use your screen?"
msgstr "ອະນຸຍາດໃຫ້ {site} ໃຊ້ໜ້າຈໍຂອງທ່ານຫຼືບໍ່?"

msgid "App data cleared"
msgstr "ລ້າງຂໍ້ມູນແອັບແລ້ວ"

msgid "Appearance"
msgstr "ຮູບລັກສະນະ"

msgid "Applies the next time ZTBrowser starts"
msgstr "ຈະມີຜົນໃນຄັ້ງຕໍ່ໄປທີ່ ZTBrowser ເລີ່ມຕົ້ນ"

msgid "Asking for relay descriptors"
msgstr "ກຳລັງຮ້ອງຂໍຄຳອະທິບາຍຂອງຣີເລ"

msgid "Asking for the network status"
msgstr "ກຳລັງຮ້ອງຂໍສະຖານະເຄືອຂ່າຍ"

msgid "Back"
msgstr "ກັບຄືນ"

msgid "Back and Forward"
msgstr "ກັບຄືນ ແລະ ໄປໜ້າ"

msgid "Best wherever Tor is not blocked."
msgstr "ດີທີ່ສຸດໃນບ່ອນທີ່ Tor ບໍ່ຖືກບລັອກ."

msgid "Bridges I provide"
msgstr "ຂົວທີ່ຂ້ອຍໃຫ້ເອງ"

msgid "Bridges are unlisted Tor relays for networks that block Tor."
msgstr "ຂົວແມ່ນຣີເລ Tor ທີ່ບໍ່ໄດ້ລະບຸໄວ້ສາທາລະນະ ສຳລັບເຄືອຂ່າຍທີ່ບລັອກ Tor."

msgid "Browsing data burned"
msgstr "ລຶບຂໍ້ມູນການທ່ອງເວັບແລ້ວ"

msgid "Burn Browsing Data"
msgstr "ລຶບຂໍ້ມູນການທ່ອງເວັບ"

msgid "Burn Browsing Data?"
msgstr "ລຶບຂໍ້ມູນການທ່ອງເວັບບໍ?"

msgid "Buttons shown around the address bar in this profile's windows."
msgstr "ປຸ່ມທີ່ສະແດງອ້ອມແຖບທີ່ຢູ່ໃນໜ້າຕ່າງຂອງໂປຣໄຟລ໌ນີ້."

msgid "C_lear"
msgstr "ລ້າງ(_L)"

msgid "Cannot Connect to Tor"
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບ Tor ໄດ້"

msgid "Cannot reach Tor's control port: {error}"
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງພອດຄວບຄຸມຂອງ Tor ໄດ້: {error}"

msgid "Cannot read Tor's control cookie: {error}"
msgstr "ບໍ່ສາມາດອ່ານຄຸກກີຄວບຄຸມຂອງ Tor ໄດ້: {error}"

msgid "Cannot remove Tor's old control port file: {error}"
msgstr "ບໍ່ສາມາດລຶບໄຟລ໌ພອດຄວບຄຸມເກົ່າຂອງ Tor ໄດ້: {error}"

msgid "Cannot save download: {error}"
msgstr "ບໍ່ສາມາດບັນທຶກການດາວໂຫຼດໄດ້: {error}"

msgid "Cannot start Tor: {error}"
msgstr "ບໍ່ສາມາດເລີ່ມ Tor ໄດ້: {error}"

msgid "Cannot write Tor's configuration: {error}"
msgstr "ບໍ່ສາມາດຂຽນການຕັ້ງຄ່າຂອງ Tor ໄດ້: {error}"

msgid "Cannot write to Tor's control port: {error}"
msgstr "ບໍ່ສາມາດຂຽນໃສ່ພອດຄວບຄຸມຂອງ Tor ໄດ້: {error}"

msgid "Certificate for {name}"
msgstr "ໃບຢັ້ງຢືນສຳລັບ {name}"

msgid "Check the address for a typo."
msgstr "ກະລຸນາກວດເບິ່ງວ່າທີ່ຢູ່ພິມຜິດຫຼືບໍ່."

msgid "Check the address, including the port number after the colon, if there is one."
msgstr "ກະລຸນາກວດທີ່ຢູ່, ລວມທັງເລກພອດຫຼັງຈຸດຄູ່ ຖ້າມີ."

msgid "Check the network cable or the Wi-Fi connection."
msgstr "ກະລຸນາກວດສາຍເຄືອຂ່າຍ ຫຼື ການເຊື່ອມຕໍ່ Wi-Fi."

msgid "Check your internet connection."
msgstr "ກະລຸນາກວດການເຊື່ອມຕໍ່ອິນເຕີເນັດຂອງທ່ານ."

msgid "Clear App Data…"
msgstr "ລ້າງຂໍ້ມູນແອັບ…"

msgid "Clear Data of {name}?"
msgstr "ລ້າງຂໍ້ມູນຂອງ {name} ບໍ?"

msgid "Close tabs or apps you don’t need, then reload the page."
msgstr "ປິດແຖບ ຫຼື ແອັບທີ່ບໍ່ຈຳເປັນ, ແລ້ວໂຫຼດໜ້ານີ້ໃໝ່."

msgid "Close {name} before deleting it"
msgstr "ປິດ {name} ກ່ອນລຶບ"

msgid "Closes all tabs and windows of this profile and deletes its cookies, site data, cache and history."
msgstr "ປິດທຸກແຖບ ແລະ ໜ້າຕ່າງຂອງໂປຣໄຟລ໌ນີ້ ແລະ ລຶບຄຸກກີ, ຂໍ້ມູນເວັບໄຊ, ແຄຊ ແລະ ປະຫວັດຂອງມັນ."

msgid "Connect"
msgstr "ເຊື່ອມຕໍ່"

msgid "Connect directly"
msgstr "ເຊື່ອມຕໍ່ໂດຍກົງ"

msgid "Connected"
msgstr "ເຊື່ອມຕໍ່ແລ້ວ"

msgid "Connected to a relay directory server"
msgstr "ເຊື່ອມຕໍ່ກັບເຊີບເວີລາຍຊື່ຣີເລແລ້ວ"

msgid "Connected to a relay to build circuits"
msgstr "ເຊື່ອມຕໍ່ກັບຣີເລເພື່ອສ້າງວົງຈອນແລ້ວ"

msgid "Connected to pluggable transport"
msgstr "ເຊື່ອມຕໍ່ກັບທຣານສປອດແບບປລັກອິນແລ້ວ"

msgid "Connected to pluggable transport to build circuits"
msgstr "ເຊື່ອມຕໍ່ກັບທຣານສປອດແບບປລັກອິນເພື່ອສ້າງວົງຈອນແລ້ວ"

msgid "Connected to proxy"
msgstr "ເຊື່ອມຕໍ່ກັບພຣັອກຊີແລ້ວ"

msgid "Connected to proxy to build circuits"
msgstr "ເຊື່ອມຕໍ່ກັບພຣັອກຊີເພື່ອສ້າງວົງຈອນແລ້ວ"

msgid "Connected to the Tor network"
msgstr "ເຊື່ອມຕໍ່ກັບເຄືອຂ່າຍ Tor ແລ້ວ"

msgid "Connecting to Tor"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບ Tor"

msgid "Connecting to a relay directory server"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບເຊີບເວີລາຍຊື່ຣີເລ"

msgid "Connecting to a relay to build circuits"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບຣີເລເພື່ອສ້າງວົງຈອນ"

msgid "Connecting to pluggable transport"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບທຣານສປອດແບບປລັກອິນ"

msgid "Connecting to pluggable transport to build circuits"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບທຣານສປອດແບບປລັກອິນເພື່ອສ້າງວົງຈອນ"

msgid "Connecting to proxy"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບພຣັອກຊີ"

msgid "Connecting to proxy to build circuits"
msgstr "ກຳລັງເຊື່ອມຕໍ່ກັບພຣັອກຊີເພື່ອສ້າງວົງຈອນ"

msgid "Connection Settings…"
msgstr "ການຕັ້ງຄ່າການເຊື່ອມຕໍ່…"

msgid "Content Scope Scripts, the privacy configuration and the TrackerRadarKit rule algorithm."
msgstr "Content Scope Scripts, ການຕັ້ງຄ່າຄວາມເປັນສ່ວນຕົວ ແລະ ອັລກໍຣິທຶມກົດຂອງ TrackerRadarKit."

msgid "Could not install the app: {error}"
msgstr "ບໍ່ສາມາດຕິດຕັ້ງແອັບໄດ້: {error}"

msgid "Could not remove everything: {error}"
msgstr "ບໍ່ສາມາດລຶບທຸກຢ່າງໄດ້: {error}"

msgid "Delete"
msgstr "ລຶບ"

msgid "Delete this profile's cookies, site data and cache"
msgstr "ລຶບຄຸກກີ, ຂໍ້ມູນເວັບໄຊ ແລະ ແຄຊຂອງໂປຣໄຟລ໌ນີ້"

msgid "Disguised connections to Tor Browser's built-in bridges."
msgstr "ການເຊື່ອມຕໍ່ແບບປອມຕົວໄປຫາຂົວທີ່ມີມາພ້ອມກັບ Tor Browser."

msgid "Disguised connections to Tor Browser's built-in bridges. Needs {package}."
msgstr "ການເຊື່ອມຕໍ່ແບບປອມຕົວໄປຫາຂົວທີ່ມີມາພ້ອມກັບ Tor Browser. ຕ້ອງການ {package}."

msgid "Download failed: {error}"
msgstr "ການດາວໂຫຼດບໍ່ສຳເລັດ: {error}"

msgid "Downloaded at run time from DuckDuckGo; licensed CC BY-NC-SA 4.0."
msgstr "ດາວໂຫຼດຕອນໃຊ້ງານຈາກ DuckDuckGo; ໃບອະນຸຍາດ CC BY-NC-SA 4.0."

msgid "Downloaded {name}"
msgstr "ດາວໂຫຼດ {name} ແລ້ວ"

msgid "DuckDuckGo protections"
msgstr "ການປ້ອງກັນຂອງ DuckDuckGo"

msgid "Each app runs in its own window and process, with cookies and logins of its own."
msgstr "ແຕ່ລະແອັບເຮັດວຽກໃນໜ້າຕ່າງ ແລະ ໂປຣເຊສຂອງຕົນເອງ ພ້ອມຄຸກກີ ແລະ ການເຂົ້າສູ່ລະບົບຂອງຕົນເອງ."

msgid "Each profile keeps its own cookies, logins, history and cache, and runs as a separate process."
msgstr "ແຕ່ລະໂປຣໄຟລ໌ເກັບຄຸກກີ, ການເຂົ້າສູ່ລະບົບ, ປະຫວັດ ແລະ ແຄຊຂອງຕົນເອງ ແລະ ເຮັດວຽກເປັນໂປຣເຊສແຍກຕ່າງຫາກ."

msgid "Establishing a Tor circuit"
msgstr "ກຳລັງສ້າງວົງຈອນ Tor"

msgid "Establishing an encrypted directory connection"
msgstr "ກຳລັງສ້າງການເຊື່ອມຕໍ່ລາຍຊື່ທີ່ເຂົ້າລະຫັດ"

msgid "File not found"
msgstr "ບໍ່ພົບໄຟລ໌"

msgid "Find in Page…"
msgstr "ຄົ້ນຫາໃນໜ້າ…"

msgid "Find in page"
msgstr "ຄົ້ນຫາໃນໜ້າ"

msgid "Finished handshake with a relay directory server"
msgstr "ສຳເລັດການຈັບມືກັບເຊີບເວີລາຍຊື່ຣີເລແລ້ວ"

msgid "Finished handshake with a relay to build circuits"
msgstr "ສຳເລັດການຈັບມືກັບຣີເລເພື່ອສ້າງວົງຈອນແລ້ວ"

msgid "Finishing handshake with a relay directory server"
msgstr "ກຳລັງຈັບມືກັບເຊີບເວີລາຍຊື່ຣີເລໃຫ້ສຳເລັດ"

msgid "Finishing handshake with a relay to build circuits"
msgstr "ກຳລັງຈັບມືກັບຣີເລເພື່ອສ້າງວົງຈອນໃຫ້ສຳເລັດ"

msgid "Forward"
msgstr "ໄປໜ້າ"

msgid "From bridges.torproject.org, by e-mail or from a friend."
msgstr "ຈາກ bridges.torproject.org, ທາງອີເມວ ຫຼື ຈາກໝູ່ເພື່ອນ."

msgid "Go to Home Page"
msgstr "ໄປໜ້າຫຼັກ"

msgid "Go to the previous or next page"
msgstr "ໄປໜ້າກ່ອນໜ້າ ຫຼື ໜ້າຖັດໄປ"

msgid "Go to the site’s home page and look for the page from there."
msgstr "ໄປທີ່ໜ້າຫຼັກຂອງເວັບໄຊ ແລ້ວຄົ້ນຫາໜ້ານັ້ນຈາກບ່ອນນັ້ນ."

msgid "How to Reach Tor"
msgstr "ວິທີເຂົ້າເຖິງ Tor"

msgid "If it crashes again after reloading, the page itself may be broken."
msgstr "ຖ້າມັນຂັດຂ້ອງອີກຫຼັງຈາກໂຫຼດໃໝ່, ອາດເປັນເພາະໜ້ານັ້ນເອງມີບັນຫາ."

msgid "If the address is right, the site may no longer exist."
msgstr "ຖ້າທີ່ຢູ່ຖືກຕ້ອງ, ເວັບໄຊອາດບໍ່ມີອີກແລ້ວ."

msgid "If you have an account on this site, sign in and try again."
msgstr "ຖ້າທ່ານມີບັນຊີໃນເວັບໄຊນີ້, ໃຫ້ເຂົ້າສູ່ລະບົບແລ້ວລອງໃໝ່."

msgid "If you use a VPN or your own DNS server, check that it works."
msgstr "ຖ້າທ່ານໃຊ້ VPN ຫຼື ເຊີບເວີ DNS ຂອງຕົນເອງ, ໃຫ້ກວດວ່າມັນເຮັດວຽກຢູ່."

msgid "If you use a VPN, firewall or proxy, check that it isn’t blocking the site."
msgstr "ຖ້າທ່ານໃຊ້ VPN, ໄຟວໍ ຫຼື ພຣັອກຊີ, ໃຫ້ກວດວ່າມັນບໍ່ໄດ້ບລັອກເວັບໄຊ."

