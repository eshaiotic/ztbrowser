msgstr "Gör till standard"

msgid "Don't Ask Again"
msgstr "Fråga inte igen"

msgid "Close"
msgstr "Stäng"

msgid "Could not make ZTBrowser the default browser: {error}"
msgstr "Det gick inte att göra ZTBrowser till standardwebbläsare: {error}"

msgid "Default Browser"
msgstr "Standardwebbläsare"

msgid "ZTBrowser opens links from other programs"
msgstr "ZTBrowser öppnar länkar från andra program"

msgid "Links from other programs open in {browser}"
msgstr "Länkar från andra program öppnas i {browser}"

msgid "Another browser opens links from other programs"
msgstr "En annan webbläsare öppnar länkar från andra program"

msgid "Only an installed ZTBrowser can open links from other programs"
msgstr "Bara en installerad ZTBrowser kan öppna länkar från andra program"

msgid "The desktop does not say which browser opens links"
msgstr "Skrivbordet anger inte vilken webbläsare som öppnar länkar"

msgid "Ask When ZTBrowser Starts"
msgstr "Fråga när ZTBrowser startar"

msgid "Offer to make ZTBrowser the default browser while another browser opens links"
msgstr "Erbjud att göra ZTBrowser till standardwebbläsare medan en annan webbläsare öppnar länkar"
