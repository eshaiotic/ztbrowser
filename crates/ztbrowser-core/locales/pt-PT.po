msgid "Delete profile {name}?"
msgstr "Eliminar o perfil {name}?"

msgid "Deletes the profile with its cookies, logins, history and cache. This cannot be undone."
msgstr "Elimina o perfil com os seus cookies, inícios de sessão, histórico e cache. Isto não pode ser anulado."

msgid "ZTBrowser is not your default browser"
msgstr "O ZTBrowser não é o seu navegador predefinido"

msgid "Make Default"
msgstr "Tornar predefinido"

msgid "Don't Ask Again"
msgstr "Não perguntar novamente"

msgid "Close"
msgstr "Fechar"

msgid "Could not make ZTBrowser the default browser: {error}"
msgstr "Não foi possível tornar o ZTBrowser o navegador predefinido: {error}"

msgid "Default Browser"
msgstr "Navegador predefinido"

msgid "ZTBrowser opens links from other programs"
msgstr "O ZTBrowser abre as ligações de outros programas"

msgid "Links from other programs open in {browser}"
msgstr "As ligações de outros programas abrem em {browser}"

msgid "Another browser opens links from other programs"
msgstr "Outro navegador abre as ligações de outros programas"

msgid "Only an installed ZTBrowser can open links from other programs"
msgstr "Só um ZTBrowser instalado pode abrir as ligações de outros programas"

msgid "The desktop does not say which browser opens links"
msgstr "O ambiente de trabalho não indica qual o navegador que abre as ligações"

msgid "Ask When ZTBrowser Starts"
msgstr "Perguntar ao iniciar o ZTBrowser"

msgid "Offer to make ZTBrowser the default browser while another browser opens links"
msgstr "Propor tornar o ZTBrowser o navegador predefinido enquanto outro navegador abrir as ligações"
