msgstr "Impossible de définir ZTBrowser comme navigateur par défaut : {error}"

msgid "Default Browser"
msgstr "Navigateur par défaut"

msgid "ZTBrowser opens links from other programs"
msgstr "ZTBrowser ouvre les liens des autres programmes"

msgid "Links from other programs open in {browser}"
msgstr "Les liens des autres programmes s’ouvrent dans {browser}"

msgid "Another browser opens links from other programs"
msgstr "Un autre navigateur ouvre les liens des autres programmes"

msgid "Only an installed ZTBrowser can open links from other programs"
msgstr "Seul un ZTBrowser installé peut ouvrir les liens des autres programmes"

msgid "The desktop does not say which browser opens links"
msgstr "Le bureau n’indique pas quel navigateur ouvre les liens"

msgid "Ask When ZTBrowser Starts"
msgstr "Demander au démarrage de ZTBrowser"

