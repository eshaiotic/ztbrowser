msgstr "ZTBrowser is niet je standaardbrowser"

msgid "Make Default"
msgstr "Als standaard instellen"

msgid "Don't Ask Again"
msgstr "Niet meer vragen"

msgid "Close"
msgstr "Sluiten"

msgid "Could not make ZTBrowser the default browser: {error}"
msgstr "Kan ZTBrowser niet als standaardbrowser instellen: {error}"

msgid "Default Browser"
msgstr "Standaardbrowser"

msgid "ZTBrowser opens links from other programs"
msgstr "ZTBrowser opent links uit andere programma’s"

msgid "Links from other programs open in {browser}"
msgstr "Links uit andere programma’s worden geopend in {browser}"

msgid "Another browser opens links from other programs"
msgstr "Een andere browser opent links uit andere programma’s"

msgid "Only an installed ZTBrowser can open links from other programs"
msgstr "Alleen een geïnstalleerde ZTBrowser kan links uit andere programma’s openen"

msgid "The desktop does not say which browser opens links"
msgstr "Het bureaublad meldt niet welke browser links opent"

msgid "Ask When ZTBrowser Starts"
msgstr "Vragen bij het starten van ZTBrowser"

msgid "Offer to make ZTBrowser the default browser while another browser opens links"
msgstr "Aanbieden om ZTBrowser als standaardbrowser in te stellen zolang een andere browser links opent"
