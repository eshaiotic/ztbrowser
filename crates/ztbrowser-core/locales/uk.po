msgstr "Не вдалося встановити застосунок: {error}"

msgid "Could not remove everything: {error}"
msgstr "Не вдалося видалити все: {error}"

msgid "Delete"
msgstr "Видалити"

msgid "Delete this profile's cookies, site data and cache"
msgstr "Видалити файли cookie, дані сайтів і кеш цього профілю"

msgid "Disguised connections to Tor Browser's built-in bridges."
msgstr "Замасковані підключення до вбудованих мостів Tor Browser."

msgid "Disguised connections to Tor Browser's built-in bridges. Needs {package}."
msgstr "Замасковані підключення до вбудованих мостів Tor Browser. Потрібен {package}."

msgid "Download failed: {error}"
msgstr "Не вдалося завантажити файл: {error}"

msgid "Downloaded at run time from DuckDuckGo; licensed CC BY-NC-SA 4.0."
msgstr "Завантажується під час роботи з DuckDuckGo; ліцензія CC BY-NC-SA 4.0."

msgid "Downloaded {name}"
msgstr "Завантажено: {name}"

msgid "DuckDuckGo protections"
msgstr "Захист DuckDuckGo"

msgid "Each app runs in its own window and process, with cookies and logins of its own."
msgstr "Кожен застосунок працює у власному вікні та процесі, зі своїми файлами cookie та сеансами входу."

msgid "Each profile keeps its own cookies, logins, history and cache, and runs as a separate process."
msgstr "Кожен профіль зберігає власні файли cookie, сеанси входу, історію та кеш і працює як окремий процес."

msgid "Establishing a Tor circuit"
msgstr "Побудова ланцюжка Tor"

msgid "Establishing an encrypted directory connection"
msgstr "Встановлення зашифрованого з’єднання з каталогом"

