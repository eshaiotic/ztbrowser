msgstr "වම"

msgid "Right"
msgstr "දකුණ"

msgid "Window Buttons"
msgstr "කවුළු බොත්තම්"

msgid "Default"
msgstr "පෙරනිමි"

msgid "macOS"
msgstr "macOS"

msgid "Add Profile"
msgstr "පැතිකඩක් එක් කරන්න"

