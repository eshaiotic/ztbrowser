msgstr "Показать в папке"

msgid "Signs you out and deletes this app's cookies, site data and cache. Nothing else is affected."
msgstr "Выполняет выход из учётных записей и удаляет файлы cookie, данные сайтов и кэш этого приложения. Всё остальное остаётся нетронутым."

msgid "Some data could not be deleted: {error}"
msgstr "Не удалось удалить часть данных: {error}"

