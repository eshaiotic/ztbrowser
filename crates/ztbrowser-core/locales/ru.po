msgstr "Не удаётся записать конфигурацию Tor: {error}"

msgid "Cannot write to Tor's control port: {error}"
msgstr "Не удаётся выполнить запись в управляющий порт Tor: {error}"

msgid "Certificate for {name}"
msgstr "Сертификат для {name}"

msgid "Check the address for a typo."
msgstr "Проверьте, нет ли в адресе опечатки."

msgid "Check the address, including the port number after the colon, if there is one."
msgstr "Проверьте адрес, включая номер порта после двоеточия, если он указан."

msgid "Check the network cable or the Wi-Fi connection."
msgstr "Проверьте сетевой кабель или подключение к Wi-Fi."

msgid "Check your internet connection."
msgstr "Проверьте подключение к интернету."

msgid "Clear App Data…"
msgstr "Очистить данные приложения…"

msgid "Clear Data of {name}?"
msgstr "Очистить данные приложения {name}?"

msgid "Close tabs or apps you don’t need, then reload the page."
msgstr "Закройте ненужные вкладки или приложения, затем обновите страницу."

msgid "Close {name} before deleting it"
msgstr "Закройте {name} перед удалением"

msgid "Closes all tabs and windows of this profile and deletes its cookies, site data, cache and history."
msgstr "Закрывает все вкладки и окна этого профиля и удаляет его файлы cookie, данные сайтов, кэш и историю."

msgid "Connect"
msgstr "Подключиться"

