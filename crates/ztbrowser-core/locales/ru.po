msgstr "Запуск Tor…"

msgid "Switch tracker protection off or on for the site"
msgstr "Включить или отключить защиту от трекеров для сайта"

msgid "System default ({language})"
msgstr "Как в системе ({language})"

msgid "The authority that issued the certificate has revoked it."
msgstr "Центр сертификации, выдавший сертификат, отозвал его."

msgid "The bridge line has no address: {line}"
msgstr "В строке моста нет адреса: {line}"

msgid "The certificate could not be verified."
msgstr "Не удалось проверить сертификат."

msgid "The certificate is signed with an algorithm that is no longer safe."
msgstr "Сертификат подписан алгоритмом, который больше не считается безопасным."

msgid "The certificate isn’t valid yet. Check that this computer’s date and time are right."
msgstr "Сертификат пока не действителен. Проверьте, правильно ли на этом компьютере установлены дата и время."

msgid "The certificate was issued for a different site."
msgstr "Сертификат выдан для другого сайта."

msgid "The certificate wasn’t issued by an authority this computer trusts."
msgstr "Сертификат выдан центром сертификации, которому этот компьютер не доверяет."

msgid "The connection to {host} was interrupted."
msgstr "Соединение с {host} было прервано."

msgid "The icon at the end of the address bar"
msgstr "Значок в конце адресной строки"

msgid "The language changes when ZTBrowser is restarted"
msgstr "Язык изменится после перезапуска ZTBrowser"

msgid "The language of menus, dialogs and messages, in every profile and web app."
msgstr "Язык меню, диалогов и сообщений во всех профилях и веб-приложениях."

msgid "The problem is on the site’s side. Try again in a few minutes."
msgstr "Проблема на стороне сайта. Повторите попытку через несколько минут."

msgid "The site may be down for maintenance. Try again in a few minutes."
msgstr "Возможно, на сайте ведутся технические работы. Повторите попытку через несколько минут."

msgid "The site may be overloaded. Try again in a few minutes."
msgstr "Возможно, сайт перегружен. Повторите попытку через несколько минут."

msgid "The {transport} bridges need a program that is not installed; install {package}"
msgstr "Для мостов {transport} нужна программа, которая не установлена; установите {package}"

msgid "There is no file at {path}."
msgstr "По пути {path} нет файла."

msgid "This address is blocked"
msgstr "Этот адрес заблокирован"

msgid "This connection isn’t private"
msgstr "Это соединение не защищено"

