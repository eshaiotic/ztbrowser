msgstr "Страница не работает"

msgid "This page ran out of memory"
msgstr "Странице не хватило памяти"

msgid "This site can’t be found"
msgstr "Сайт не найден"

msgid "This site can’t be reached"
msgstr "Не удаётся получить доступ к сайту"

msgid "Through volunteers' browsers; works on most censored networks."
msgstr "Через браузеры добровольцев; работает в большинстве сетей с цензурой."

msgid "Through volunteers' browsers; works on most censored networks. Needs {package}."
msgstr "Через браузеры добровольцев; работает в большинстве сетей с цензурой. Требуется {package}."

msgid "Toolbar Buttons"
msgstr "Кнопки панели инструментов"

msgid "Tor Connection"
msgstr "Подключение к Tor"

msgid "Tor Connection…"
msgstr "Подключение к Tor…"

msgid "Tor Window"
msgstr "Окно Tor"

msgid "Tor cannot use the path {path}"
msgstr "Tor не может использовать путь {path}"

msgid "Tor closed its control port"
msgstr "Tor закрыл свой управляющий порт"

msgid "Tor could not switch circuits: {error}"
msgstr "Tor не смог сменить цепочки: {error}"

msgid "Tor did not open its control port"
msgstr "Tor не открыл свой управляющий порт"

msgid "Tor is not installed. Install your distribution's tor package; the Tor window starts its own Tor and needs no Tor service running."
msgstr "Tor не установлен. Установите пакет tor из вашего дистрибутива; окно Tor запускает собственный Tor, и работающая служба Tor не нужна."

msgid "Tor opened no local SOCKS port"
msgstr "Tor не открыл локальный порт SOCKS"

msgid "Tor refused: {reason}"
msgstr "Tor отказал: {reason}"

msgid "Tor reported a problem"
msgstr "Tor сообщил о проблеме"

msgid "Tor stopped."
msgstr "Tor остановлен."

msgid "Tor's control cookie is damaged"
msgstr "Управляющий cookie-файл Tor повреждён"

msgid "Tracker Data Set"
msgstr "Набор данных о трекерах"

msgid "Tracker protection on this site"
msgstr "Защита от трекеров на этом сайте"

msgid "Try Again"
msgstr "Повторить попытку"

msgid "Try again in a few minutes."
msgstr "Повторите попытку через несколько минут."

msgid "Turn off airplane mode, if it is on."
msgstr "Отключите режим «в самолёте», если он включён."

msgid "Turns ZTBrowser Guard's filter lists into WebKit rules. Source: https://github.com/brave/adblock-rust"
msgstr "Преобразует списки фильтров ZTBrowser Guard в правила WebKit. Исходный код: https://github.com/brave/adblock-rust"

msgid "Uninstall"
msgstr "Удалить"

msgid "Unknown bridge transport: {name}"
msgstr "Неизвестный транспорт моста: {name}"

msgid "Valid until {date}"
msgstr "Действителен до {date}"

msgid "Your Bridges"
msgstr "Ваши мосты"

msgid "You’re offline"
msgstr "Вы не в сети"

msgid "Zoom In"
msgstr "Увеличить"

msgid "Zoom Out"
msgstr "Уменьшить"

msgid "_Allow"
msgstr "_Разрешить"

msgid "_Burn"
msgstr "_Стереть"

msgid "_Cancel"
msgstr "_Отмена"

msgid "_Deny"
msgstr "_Запретить"

msgid "_Install"
msgstr "_Установить"

msgid "_New Identity"
msgstr "_Новая личность"

msgid "obfs4proxy (Debian, Ubuntu), obfs4 (Fedora) or obfs4proxy from the AUR (Arch)"
msgstr "obfs4proxy (Debian, Ubuntu), obfs4 (Fedora) или obfs4proxy из AUR (Arch)"

msgid "snowflake-client (Debian, Ubuntu) or snowflake-pt-client from the AUR (Arch)"
msgstr "snowflake-client (Debian, Ubuntu) или snowflake-pt-client из AUR (Arch)"

msgid "{host} can’t handle the request right now."
msgstr "Сайт {host} сейчас не может обработать запрос."

msgid "{host} couldn’t answer this request."
msgstr "Сайт {host} не смог ответить на этот запрос."

msgid "{host} does not offer a secure connection"
msgstr "{host} не поддерживает защищённое соединение"

msgid "{host} doesn’t allow you to see this page."
msgstr "Сайт {host} не разрешает вам просматривать эту страницу."

msgid "{host} has no page at this address."
msgstr "На сайте {host} нет страницы по этому адресу."

msgid "{host} refused the connection."
msgstr "Сайт {host} отклонил подключение."

msgid "{host} took too long to respond."
msgstr "Сайт {host} слишком долго не отвечает."

msgid "{host} used more memory than a page may use, so ZTBrowser stopped it."
msgstr "Страница {host} использовала больше памяти, чем разрешено, поэтому ZTBrowser остановил её."

