msgstr "Подключение к серверу каталога узлов"

msgid "Connecting to a relay to build circuits"
msgstr "Подключение к узлу для построения цепочек"

msgid "Connecting to pluggable transport"
msgstr "Подключение к подключаемому транспорту"

msgid "Connecting to pluggable transport to build circuits"
msgstr "Подключение к подключаемому транспорту для построения цепочек"

msgid "Connecting to proxy"
msgstr "Подключение к прокси"

