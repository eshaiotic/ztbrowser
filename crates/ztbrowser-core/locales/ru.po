msgstr "Подключение к прокси для построения цепочек"

msgid "Connection Settings…"
msgstr "Параметры подключения…"

msgid "Content Scope Scripts, the privacy configuration and the TrackerRadarKit rule algorithm."
msgstr "Content Scope Scripts, конфигурация приватности и алгоритм правил TrackerRadarKit."

msgid "Could not install the app: {error}"
msgstr "Не удалось установить приложение: {error}"

msgid "Could not remove everything: {error}"
msgstr "Не удалось удалить всё: {error}"

msgid "Delete"
msgstr "Удалить"

msgid "Delete this profile's cookies, site data and cache"
msgstr "Удалить файлы cookie, данные сайтов и кэш этого профиля"

msgid "Disguised connections to Tor Browser's built-in bridges."
msgstr "Замаскированные подключения к встроенным мостам Tor Browser."

msgid "Disguised connections to Tor Browser's built-in bridges. Needs {package}."
msgstr "Замаскированные подключения к встроенным мостам Tor Browser. Требуется {package}."

msgid "Download failed: {error}"
msgstr "Не удалось загрузить файл: {error}"

msgid "Downloaded at run time from DuckDuckGo; licensed CC BY-NC-SA 4.0."
msgstr "Загружается во время работы с DuckDuckGo; лицензия CC BY-NC-SA 4.0."

msgid "Downloaded {name}"
msgstr "Загружено: {name}"

msgid "DuckDuckGo protections"
msgstr "Защита DuckDuckGo"

msgid "Each app runs in its own window and process, with cookies and logins of its own."
msgstr "Каждое приложение работает в собственном окне и процессе, со своими файлами cookie и сеансами входа."

msgid "Each profile keeps its own cookies, logins, history and cache, and runs as a separate process."
msgstr "Каждый профиль хранит свои файлы cookie, сеансы входа, историю и кэш и работает как отдельный процесс."

msgid "Establishing a Tor circuit"
msgstr "Построение цепочки Tor"

msgid "Establishing an encrypted directory connection"
msgstr "Установка зашифрованного соединения с каталогом"

msgid "File not found"
msgstr "Файл не найден"

msgid "Find in Page…"
msgstr "Найти на странице…"

msgid "Find in page"
msgstr "Поиск на странице"

msgid "Finished handshake with a relay directory server"
msgstr "Рукопожатие с сервером каталога узлов завершено"

msgid "Finished handshake with a relay to build circuits"
msgstr "Рукопожатие с узлом для построения цепочек завершено"

msgid "Finishing handshake with a relay directory server"
msgstr "Завершение рукопожатия с сервером каталога узлов"

msgid "Finishing handshake with a relay to build circuits"
msgstr "Завершение рукопожатия с узлом для построения цепочек"

msgid "Forward"
msgstr "Вперёд"

msgid "From bridges.torproject.org, by e-mail or from a friend."
msgstr "С bridges.torproject.org, по электронной почте или от знакомого."

msgid "Go to Home Page"
msgstr "Перейти на домашнюю страницу"

msgid "Go to the previous or next page"
msgstr "Перейти на предыдущую или следующую страницу"

msgid "Go to the site’s home page and look for the page from there."
msgstr "Перейдите на главную страницу сайта и поищите нужную страницу там."

msgid "How to Reach Tor"
msgstr "Как подключиться к Tor"

msgid "If it crashes again after reloading, the page itself may be broken."
msgstr "Если после обновления сбой повторится, возможно, неисправна сама страница."

msgid "If the address is right, the site may no longer exist."
msgstr "Если адрес верный, возможно, сайта больше не существует."

msgid "If you have an account on this site, sign in and try again."
msgstr "Если у вас есть учётная запись на этом сайте, войдите в неё и повторите попытку."

msgid "If you use a VPN or your own DNS server, check that it works."
msgstr "Если вы используете VPN или собственный DNS-сервер, проверьте, что он работает."

msgid "If you use a VPN, firewall or proxy, check that it isn’t blocking the site."
msgstr "Если вы используете VPN, брандмауэр или прокси, проверьте, не блокируют ли они сайт."

msgid "ZTBrowser Guard filter lists"
msgstr "Списки фильтров ZTBrowser Guard"

msgid "ZTBrowser can’t open {host} because this computer isn’t connected to a network."
msgstr "ZTBrowser не может открыть {host}, потому что этот компьютер не подключён к сети."

msgid "ZTBrowser couldn’t find a server at {host}."
msgstr "ZTBrowser не удалось найти сервер по адресу {host}."

msgid "ZTBrowser doesn’t connect to {host} on this port."
msgstr "ZTBrowser не подключается к {host} через этот порт."

msgid "ZTBrowser's own Tor is connecting. Nothing leaves this window until it is connected."
msgstr "Собственный Tor ZTBrowser подключается. Пока подключение не установлено, из этого окна ничего не отправляется."

