msgstr "Кнопки вокруг адресной строки в окнах этого профиля."

msgid "C_lear"
msgstr "О_чистить"

msgid "Cannot Connect to Tor"
msgstr "Не удаётся подключиться к Tor"

msgid "Cannot reach Tor's control port: {error}"
msgstr "Не удаётся связаться с управляющим портом Tor: {error}"

msgid "Cannot read Tor's control cookie: {error}"
msgstr "Не удаётся прочитать управляющий cookie-файл Tor: {error}"

