msgstr "চওড়া ঠিকানা বার"

msgid "The address bar fills all the room in the toolbar; off keeps it short and centred"
msgstr "ঠিকানা বার টুলবারের সব জায়গা জুড়ে থাকে; বন্ধ থাকলে এটি ছোট ও মাঝখানে থাকে"

msgid "No apps installed yet"
msgstr "এখনও কোনো অ্যাপ ইনস্টল করা হয়নি"

msgid "Uninstall {name}?"
msgstr "{name} আনইনস্টল করবেন?"

msgid "Deletes the app with its cookies, logins and data. This cannot be undone."
msgstr "অ্যাপটি তার কুকি, লগইন ও ডেটাসহ মুছে ফেলা হবে। এটি আর ফেরানো যাবে না।"

msgid "Tab Position"
msgstr "ট্যাবের অবস্থান"

msgid "Top"
msgstr "উপরে"

msgid "Bottom"
msgstr "নিচে"

msgid "Left"
msgstr "বামে"

msgid "Right"
msgstr "ডানে"

msgid "Window Buttons"
msgstr "উইন্ডো বোতাম"

msgid "Default"
msgstr "ডিফল্ট"

msgid "macOS"
msgstr "macOS"

msgid "Add Profile"
msgstr "প্রোফাইল যোগ করুন"

msgid "Delete profile {name}?"
msgstr "প্রোফাইল {name} মুছবেন?"

msgid "Deletes the profile with its cookies, logins, history and cache. This cannot be undone."
msgstr "প্রোফাইলটি তার কুকি, লগইন, ইতিহাস ও ক্যাশসহ মুছে ফেলা হবে। এটি আর ফেরানো যাবে না।"

msgid "ZTBrowser is not your default browser"
msgstr "ZTBrowser আপনার ডিফল্ট ব্রাউজার নয়"

msgid "Make Default"
msgstr "ডিফল্ট করুন"

msgid "Don't Ask Again"
msgstr "আর জিজ্ঞাসা করবেন না"

msgid "Close"
msgstr "বন্ধ করুন"

msgid "Could not make ZTBrowser the default browser: {error}"
msgstr "ZTBrowser-কে ডিফল্ট ব্রাউজার করা যায়নি: {error}"

msgid "Default Browser"
msgstr "ডিফল্ট ব্রাউজার"

msgid "ZTBrowser opens links from other programs"
msgstr "অন্যান্য প্রোগ্রামের লিংক ZTBrowser খোলে"

msgid "Links from other programs open in {browser}"
msgstr "অন্যান্য প্রোগ্রামের লিংক {browser}-এ খোলে"

msgid "Another browser opens links from other programs"
msgstr "অন্যান্য প্রোগ্রামের লিংক অন্য একটি ব্রাউজার খোলে"

msgid "Only an installed ZTBrowser can open links from other programs"
msgstr "শুধু ইনস্টল করা ZTBrowser অন্যান্য প্রোগ্রামের লিংক খুলতে পারে"

msgid "The desktop does not say which browser opens links"
msgstr "ডেস্কটপ জানায় না কোন ব্রাউজার লিংক খোলে"

msgid "Ask When ZTBrowser Starts"
msgstr "ZTBrowser চালু হলে জিজ্ঞাসা করুন"

msgid "Offer to make ZTBrowser the default browser while another browser opens links"
msgstr "অন্য ব্রাউজার লিংক খুললে ZTBrowser-কে ডিফল্ট ব্রাউজার করার প্রস্তাব দিন"
