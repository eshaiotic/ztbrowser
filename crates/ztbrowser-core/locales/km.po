msgid "About ZTBrowser"
msgstr "អំពី ZTBrowser"

msgid "Access denied"
msgstr "ការចូលប្រើត្រូវបានបដិសេធ"

msgid "Allow {requesting} to use its cookies and data while you are on {current}?"
msgstr "អនុញ្ញាតឱ្យ {requesting} ប្រើខូគី និងទិន្នន័យរបស់វា ពេលកំពុងនៅលើ {current} ឬទេ?"

msgid "Allow {site} to know your location?"
msgstr "អនុញ្ញាតឱ្យ {site} ដឹងទីតាំងរបស់អ្នកឬទេ?"

