msgstr "អនុញ្ញាតឱ្យ {site} អានក្ដារតម្បៀតខ្ទាស់របស់អ្នកឬទេ?"

msgid "Allow {site} to show notifications?"
msgstr "អនុញ្ញាតឱ្យ {site} បង្ហាញការជូនដំណឹងឬទេ?"

msgid "Allow {site} to use your camera and microphone?"
msgstr "អនុញ្ញាតឱ្យ {site} ប្រើកាមេរ៉ា និងមីក្រូហ្វូនរបស់អ្នកឬទេ?"

msgid "Allow {site} to use your camera?"
msgstr "អនុញ្ញាតឱ្យ {site} ប្រើកាមេរ៉ារបស់អ្នកឬទេ?"

msgid "Allow {site} to use your microphone?"
msgstr "អនុញ្ញាតឱ្យ {site} ប្រើមីក្រូហ្វូនរបស់អ្នកឬទេ?"

msgid "Allow {site} to use your screen?"
msgstr "អនុញ្ញាតឱ្យ {site} ប្រើអេក្រង់របស់អ្នកឬទេ?"

msgid "App data cleared"
msgstr "បានសម្អាតទិន្នន័យកម្មវិធី"

msgid "Appearance"
msgstr "រូបរាង"

msgid "Applies the next time ZTBrowser starts"
msgstr "នឹងអនុវត្តនៅពេល ZTBrowser ចាប់ផ្តើមលើកក្រោយ"

msgid "Asking for relay descriptors"
msgstr "កំពុងស្នើសុំព័ត៌មានពិពណ៌នាអំពីថ្នាំងបញ្ជូនបន្ត"

msgid "Asking for the network status"
msgstr "កំពុងស្នើសុំស្ថានភាពបណ្តាញ"

msgid "Back"
msgstr "ថយក្រោយ"

msgid "Back and Forward"
msgstr "ថយក្រោយ និងទៅមុខ"

msgid "Best wherever Tor is not blocked."
msgstr "ល្អបំផុតនៅគ្រប់កន្លែងដែល Tor មិនត្រូវបានរារាំង។"

