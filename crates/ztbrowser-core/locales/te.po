msgid "Allow {site} to use your microphone?"
msgstr "మీ మైక్రోఫోన్‌ను {site} ఉపయోగించడానికి అనుమతించాలా?"

msgid "Allow {site} to use your screen?"
msgstr "మీ స్క్రీన్‌ను {site} ఉపయోగించడానికి అనుమతించాలా?"

msgid "App data cleared"
