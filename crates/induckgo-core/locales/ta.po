msgstr "நிறுவு(_I)"

msgid "_New Identity"
msgstr "புதிய அடையாளம்(_N)"

msgid "obfs4proxy (Debian, Ubuntu), obfs4 (Fedora) or obfs4proxy from the AUR (Arch)"
msgstr "obfs4proxy (Debian, Ubuntu), obfs4 (Fedora) அல்லது AUR இலிருந்து obfs4proxy (Arch)"

msgid "snowflake-client (Debian, Ubuntu) or snowflake-pt-client from the AUR (Arch)"
msgstr "snowflake-client (Debian, Ubuntu) அல்லது AUR இலிருந்து snowflake-pt-client (Arch)"

