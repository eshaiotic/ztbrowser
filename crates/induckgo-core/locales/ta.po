msgid "About InDuckGo"
msgstr "InDuckGo பற்றி"

msgid "Access denied"
msgstr "அணுகல் மறுக்கப்பட்டது"

msgid "Allow {requesting} to use its cookies and data while you are on {current}?"
msgstr "{current} தளத்தில் இருக்கும்போது {requesting} தனது குக்கீகளையும் தரவையும் பயன்படுத்த அனுமதிக்கவா?"

msgid "Allow {site} to know your location?"
msgstr "உங்கள் இருப்பிடத்தை {site} அறிய அனுமதிக்கவா?"

msgid "Allow {site} to read your clipboard?"
msgstr "உங்கள் கிளிப்போர்டை {site} படிக்க அனுமதிக்கவா?"

msgid "Allow {site} to show notifications?"
msgstr "{site} அறிவிப்புகளைக் காட்ட அனுமதிக்கவா?"

msgid "Allow {site} to use your camera and microphone?"
msgstr "உங்கள் கேமராவையும் மைக்ரோஃபோனையும் {site} பயன்படுத்த அனுமதிக்கவா?"

msgid "Allow {site} to use your camera?"
msgstr "உங்கள் கேமராவை {site} பயன்படுத்த அனுமதிக்கவா?"

msgid "Allow {site} to use your microphone?"
msgstr "உங்கள் மைக்ரோஃபோனை {site} பயன்படுத்த அனுமதிக்கவா?"

msgid "Allow {site} to use your screen?"
msgstr "உங்கள் திரையை {site} பயன்படுத்த அனுமதிக்கவா?"

msgid "App data cleared"
msgstr "பயன்பாட்டுத் தரவு அழிக்கப்பட்டது"

msgid "Appearance"
msgstr "தோற்றம்"

msgid "Applies the next time InDuckGo starts"
msgstr "InDuckGo அடுத்து தொடங்கும்போது செயலுக்கு வரும்"

msgid "Asking for relay descriptors"
msgstr "ரிலே விளக்கங்களைக் கோருகிறது"

msgid "Asking for the network status"
msgstr "பிணைய நிலையைக் கோருகிறது"

msgid "Back"
msgstr "பின்செல்"

msgid "Back and Forward"
msgstr "பின்செல் மற்றும் முன்செல்"

msgid "Best wherever Tor is not blocked."
msgstr "Tor தடுக்கப்படாத இடங்களில் சிறந்தது."

msgid "Bridges I provide"
msgstr "நான் வழங்கும் பாலங்கள்"

msgid "Bridges are unlisted Tor relays for networks that block Tor."
msgstr "பாலங்கள் என்பவை Tor-ஐத் தடுக்கும் பிணையங்களுக்கான, பட்டியலிடப்படாத Tor ரிலேக்கள்."

msgid "Browsing data burned"
msgstr "உலாவல் தரவு அழிக்கப்பட்டது"

msgid "Burn Browsing Data"
msgstr "உலாவல் தரவை அழி"

msgid "Burn Browsing Data?"
msgstr "உலாவல் தரவை அழிக்கவா?"

msgid "Buttons shown around the address bar in this profile's windows."
msgstr "இந்தச் சுயவிவரத்தின் சாளரங்களில் முகவரிப் பட்டையைச் சுற்றிக் காட்டப்படும் பொத்தான்கள்."

msgid "C_lear"
msgstr "அழி(_L)"

msgid "Cannot Connect to Tor"
msgstr "Tor உடன் இணைக்க முடியவில்லை"

msgid "Cannot reach Tor's control port: {error}"
msgstr "Tor-இன் கட்டுப்பாட்டுத் துறையை அடைய முடியவில்லை: {error}"

msgid "Cannot read Tor's control cookie: {error}"
msgstr "Tor-இன் கட்டுப்பாட்டுக் குக்கீயைப் படிக்க முடியவில்லை: {error}"

msgid "Cannot remove Tor's old control port file: {error}"
msgstr "Tor-இன் பழைய கட்டுப்பாட்டுத் துறைக் கோப்பை அகற்ற முடியவில்லை: {error}"

msgid "Cannot save download: {error}"
msgstr "பதிவிறக்கத்தைச் சேமிக்க முடியவில்லை: {error}"

msgid "Cannot start Tor: {error}"
msgstr "Tor-ஐத் தொடங்க முடியவில்லை: {error}"

msgid "Cannot write Tor's configuration: {error}"
msgstr "Tor-இன் உள்ளமைவை எழுத முடியவில்லை: {error}"

msgid "Cannot write to Tor's control port: {error}"
msgstr "Tor-இன் கட்டுப்பாட்டுத் துறையில் எழுத முடியவில்லை: {error}"

msgid "Certificate for {name}"
msgstr "{name}-க்கான சான்றிதழ்"

msgid "Check the address for a typo."
msgstr "முகவரியில் எழுத்துப்பிழை உள்ளதா எனப் பாருங்கள்."

